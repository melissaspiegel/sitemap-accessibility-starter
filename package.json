{
  "name": "sitemap-accessibility-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "@lit/context": "^1.1.5",
    "ag-grid-community": "^34.3.1",
    "ag-grid-lit": "^34.3.1",
    "express": "^5.1.0",
    "lit": "^3.3.1",
    "mdui": "^2.1.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
